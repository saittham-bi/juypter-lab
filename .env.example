# =============================================================================
# .env.example – Vorlage für lokale Entwicklung
# Auf Virtuozzo PaaS werden diese als Umgebungsvariablen im Dashboard gesetzt
# =============================================================================

# JupyterLab – Token generieren mit:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JUPYTER_TOKEN=dein-sicherer-token-hier
JUPYTER_PORT=8888

# Infomaniak AI (Mistral)
INFOMANIAK_API_KEY=dein-infomaniak-api-key
INFOMANIAK_PRODUCT_ID=12345

# Anthropic Claude (optional, für Jupyter-AI)
ANTHROPIC_API_KEY=sk-ant-...

# DuckDB
DUCKDB_PATH=./data/main.duckdb
